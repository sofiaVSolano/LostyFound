# Copia este archivo a .env y ajusta los valores
PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo
QR_SECRET=otro-secreto-para-los-qr-dinamicos
CLIENT_URL=http://localhost:5173
# Días máximos de custodia antes de iniciar disposición (HU-10 / HU-11)
MAX_CUSTODY_DAYS=90
# Si se deja vacío, los correos se guardan en la "bandeja de desarrollo" (tabla outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lost&Found Smart <no-reply@usbcali.edu.co>"
# En producción pon NODE_ENV=production para no exponer códigos de verificación
NODE_ENV=development
